<div class="LandingContainer">
  <div class="Picture" style="background-image: url(@projectDetails.ImageUrl)">

    <StickyNote Text="@projectDetails.Name" Link="@projectDetails.LinkToProject" OpenTo="@StickyNote.TargetType.BlankPage" />
  </div>
</div>


@code {
  [Parameter] public string CurrentProjectURL { get; set; }
  ProjectDetails projectDetails;

  protected async override Task OnInitializedAsync()
  {
    projectDetails = (await ProjectDetails.GetAllProjects()).Find(x => x.Url == CurrentProjectURL);
  }
}
