@typeparam TItem

<div class="carousel-container">
  <div class="carousel-track" style="@TrackStyle">
    @foreach (var item in Items)
    {
      <div class="carousel-slide">
        @ItemTemplate(item)
      </div>
    }
  </div>

  @if (ShowControls)
  {
    <button class="carousel-btn prev" @onclick="Prev">‹</button>
    <button class="carousel-btn next" @onclick="Next">›</button>
  }
</div>

@code {
  [Parameter] public List<TItem> Items { get; set; } = [];
  [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }
  [Parameter] public int Interval { get; set; } = 3000;
  [Parameter] public bool AutoRotate { get; set; } = true;
  [Parameter] public bool ShowControls { get; set; } = true;

  private int currentIndex = 0;
  private System.Timers.Timer? timer;

  private string TrackStyle => $@"
        transform: translateX(-{currentIndex * 100}%);
        transition: transform 0.6s ease-in-out;
    ";

  protected override void OnInitialized()
  {
    if (AutoRotate)
    {
      timer = new System.Timers.Timer(Interval);
      timer.Elapsed += (_, _) => NextInternal();
      timer.Start();
    }
  }

  private void Next() => NextInternal(manual: true);
  private void Prev() => PrevInternal(manual: true);

  private void NextInternal(bool manual = false)
  {
    currentIndex = (currentIndex + 1) % Items.Count;
    InvokeAsync(StateHasChanged);
  }

  private void PrevInternal(bool manual = false)
  {
    currentIndex = (currentIndex - 1 + Items.Count) % Items.Count;
    InvokeAsync(StateHasChanged);
  }

  public void Dispose() => timer?.Dispose();
}
