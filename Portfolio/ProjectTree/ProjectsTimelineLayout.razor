@* @using System.Threading.Tasks
@using System.Text
@inject IJSRuntime JS

<div class="ProjectsTimeline">
  <div class="Middle">
    <h1 style="text-wrap: nowrap; text-align:center; margin-top: var(--GeneralMargin);">My whole programming career so
      far</h1>
    <span />
  </div>
  @if (projectDetails != null)
  {
    @for (int j = projectDetails.Count - 1; j >= 0; j--)
    {
      var i = j;
      Console.Write(projectDetails.Count);
      Console.Write(i);
      <div class="leftright1">
        @if ((i + 1) % 2 == 1)
        {
          <div class="TimeInfo">
            <p>
              Duration: @projectDetails[i].Time<br />
            <pre>@getTagString(projectDetails[i].Tags)</pre>
            </p>
          </div>
          <span />
        }
        else
        {
          <NavLink href=@projectDetails[i].Url>
            <div class="ProjectDetails" style="background-image: url(@projectDetails[i].ImageUrl)">
              <div class="ProjectTimeLineDescription">
                <ButtonStickyNote Text="@projectDetails[i].Name" />
                <ButtonStickyNote Text="@projectDetails[i].Description" />
              </div>
            </div>
          </NavLink>
          <span />
        }

      </div>
      <div class="Middle"><span /></div>

      <div class="leftright0">
        @if ((i + 1) % 2 == 1)
        {
          <NavLink href=@projectDetails[i].Url>
            <div class="ProjectDetails" style="background-image: url(@projectDetails[i].ImageUrl)">
              <div class="ProjectTimeLineDescription">
                <ButtonStickyNote Text="@projectDetails[i].Name" />
                <ButtonStickyNote Text="@projectDetails[i].Description" />
              </div>
            </div>
          </NavLink>
          <span />
        }
        else
        {
          <div class="TimeInfo">
            <p>Duration: @projectDetails[i].Time<br />
              @getTagString(projectDetails[i].Tags)
            </p>
          </div>
          <span />
        }
      </div>

    }
  }
  <h1 class="Middle" style="text-wrap: nowrap; text-align:center; margin-top: var(--GeneralMargin);">Start of my career
  </h1>
</div>




