@page "/Projects"
@using System.Threading.Tasks
@inject IJSRuntime JS

<div class="ProjectsTimeline" id="ProjectsTimeline">
	@foreach (var project in projectDetails)
	{
		<div class="PointInTime" id="@project.Name" style="background-image: url(/@project.ImageUrl); z-index: 0">
			<canvas id="pixelRevealCanvas" style="z-index: 1;" />
			<div class="DiscriptionInfo" style="z-index: 2">
				<div class="NameAndDescription">
					<ButtonStickyNote Text="@project.Name" />
					<ButtonStickyNote Text="@project.Description"/>
				</div>
				<div class="SoftwareStack">
					@foreach (var software in orderList(project))
					{
						<ButtonStickyNote Text="@software"/>
					}
				</div>
			</div>
		</div>
	}
</div>

@code {
	List<ProjectDetails>? projectDetails;

	protected override async Task OnInitializedAsync()
	{
		projectDetails = ProjectDetails.GetAllProjects();
	}

	string[] orderList(ProjectDetails currentProject)
	{
		return currentProject.SoftwareStack.OrderBy(x => x.Length).ToArray();
	}
}
