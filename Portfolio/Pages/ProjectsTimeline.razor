@page "/Projects"
@using System.Threading.Tasks
@inject IJSRuntime JS

<div class="ProjectsTimeline" id="ProjectsTimeline">
	@foreach (var project in projectDetails)
	{
		<div class="PointInTime" id="@project.Name" style="background-image: url(/@project.ImageUrl)">
			<h3>@project.Name</h3>
			<p>@project.Description</p>
			<p>Languages used: @project.ProgrammingLanguage</p>
		</div>
	}
</div>

@code {
	List<ProjectDetails>? projectDetails;

	protected override async Task OnInitializedAsync()
	{
		projectDetails = ProjectDetails.GetAllProjects();
		var module = await JS.InvokeAsync<IJSObjectReference>("import", "./JS/PixelDivs.js");
		await module.InvokeVoidAsync("PixelOverlayDivs", "ProjectsTimeline", 4);
	}


}
