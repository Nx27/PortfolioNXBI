@page "/Projects"

<div class="BestWork" style="margin-bottom: var(--GeneralMargin);">
  <h2>Highly recommend you check these out:</h2>
  <div class="BestWorkProjects">
    @foreach (var project in favProjects)
    {
      <NavLink href=@project.Url>
        <div class="BestWorkProject" style="background-image: url(@project.ImageUrl)">
          <div class="BestWorkProjectDescription">
            <ButtonStickyNote Text="@project.Name" />
          </div>
        </div>
      </NavLink>
    }
  </div>
</div>

<div class="ProjectsTimeline">
  <ProjectPreview />
</div>

<div class="Construction">
  <span>Hi mobile is still under development but coming soon :) <br />
    Please use desktop for now as all the content is there and more accessible. <br />
  </span>
  <img src="/images/NoMobileCat.jpg" style="width: 100%; margin-top: var(--GeneralMargin);" />
</div>

@code {
  List<ProjectDetails> favProjects = ProjectDetails.GetByNames("Dialog system", "Portfolio");
}