@using Portfolio.Pages
@inherits LayoutComponentBase
@inject SubBarController SubBarController
@inject NavigationManager navigationManager
@inject Portfolio.Logic.CS.FontChanger FontChanger

<Header />

@if (navigationManager.Uri.Replace(navigationManager.BaseUri, "") == "About")
{
	<div id="nobg" class="@(FontChanger.AltFont ? "Alt-Font" : "")">
		<div class="LeftSideSpace">
			<SubPageBar />
		</div>
		<div class="Content">
			@Body
		</div>
		<div class="RightSideSpace">
		</div>
	</div>
}
else
{
	<div class="@(FontChanger.AltFont ? "Alt-Font" : "")">
		<div class="LeftSideSpace">
			<SubPageBar />
		</div>
		<div class="Content">
			@Body
		</div>
		<div class="RightSideSpace">
		</div>
	</div>
}
@code {
protected override void OnInitialized()
  {
    FontChanger.OnChange += StateHasChanged;
  }

  public void Dispose()
  {
    FontChanger.OnChange -= StateHasChanged;
  }
}