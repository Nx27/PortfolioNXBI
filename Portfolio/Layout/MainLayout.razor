@using Portfolio.Pages
@inherits LayoutComponentBase
@inject SubBarController SubBarController
@inject NavigationManager navigationManager

<Header />


<T></T>

@if (navigationManager.Uri.Replace(navigationManager.BaseUri, "") == "About")
{
	<div id="nobg">
		<div class="LeftSideSpace">
			<SubPageBar />
		</div>
		<div class="Content">
			@Body
		</div>
		<div class="RightSideSpace">
		</div>
	</div>
}
else
{
	<div>
		<div class="LeftSideSpace">
			<SubPageBar />
		</div>
		<div class="Content">
			@Body
		</div>
		<div class="RightSideSpace">
		</div>
	</div>
}