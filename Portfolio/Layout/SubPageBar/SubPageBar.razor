@inject NavigationManager Navigation
@inject HttpClient Http
@inject SubBarController SubBarController

@if (SubBarController.IsVisible)
{
  <div class="SubPageBar">
    <div class="Title"><h2>SubPage</h2></div>
    <div class="Content">
      @foreach (var item in SubBarController.SubBarContentLinks)
      {
        <NormalButton OnClick="() => ScrollTo(item)" Text="@item"></NormalButton>
      }
    </div>
  </div>
}

@code {
  [Inject] IJSRuntime JS { get; set; }

  async Task ScrollTo(string id)
  {
    await JS.InvokeVoidAsync("scrollToElement", id);
  }
  protected override void OnInitialized()
  {
    SubBarController.ReRenderRequested += StateHasChanged;
  }

  public void Dispose()
  {
    SubBarController.ReRenderRequested -= StateHasChanged;
  }
}
